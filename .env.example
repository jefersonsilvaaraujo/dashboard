# Copie para .env e preencha. O .env não é versionado.

# Banco
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard_admin
POSTGRES_PASSWORD=troque-esta-senha
# Usuário somente leitura usado pelo app
APP_DB_USER=dashboard_app
APP_DB_PASSWORD=troque-esta-outra-senha

# Portas publicadas em 127.0.0.1 (acesso só pela própria máquina)
DB_PORTA=5432
APP_PORTA=8501

# Caminho do app na URL. Vazio localmente; "dashboard" na VPS (https://jefead.com.br/dashboard)
APP_BASE_URL_PATH=

# Pasta com os dados brutos (planilhas, rasters, shapefile) para o serviço etl
MESTRADO_DADOS_HOST=..
